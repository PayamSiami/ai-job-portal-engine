{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": false,
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    // ADD THIS - tells TypeScript to add .js extensions
    "moduleSuffixes": [".js", ".ts"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}